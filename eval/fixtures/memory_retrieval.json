{
  "version": 1,
  "description": "Deterministic Chinese FTS retrieval, attribution, provenance and correction lifecycle regression cases",
  "top_k": 5,
  "persons": [
    {"key": "lin_a", "name": "林舟"},
    {"key": "lin_b", "name": "林舟"},
    {"key": "zhou", "name": "周敏"}
  ],
  "memories": [
    {"key": "preference", "person": "lin_a", "text": "林舟的沟通偏好是电话，工作日通常下午方便联系。"},
    {"key": "namesake", "person": "lin_b", "text": "林舟的沟通偏好是短信，周末上午方便联系。"},
    {"key": "personal", "person": null, "text": "我的沟通偏好是邮件，准备事项写成清单。"},
    {"key": "meeting", "person": "zhou", "text": "周敏参加过杭州的产品交流会，讨论了设计研究。"}
  ],
  "distractors": {"person": "zhou", "count": 16, "text": "沟通偏好 电话 沟通偏好 电话"},
  "fields": [
    {"person": "lin_a", "field": "city", "value": "杭州", "valid_from": 1754006400000},
    {"person": "lin_a", "field": "city", "value": "上海", "valid_from": 1756684800000}
  ],
  "interactions": [
    {"key": "visit", "person": "zhou", "text": "实际拜访了周敏，讨论秋季产品计划。", "channel": "线下", "kind": "contact"}
  ],
  "cases": [
    {
      "id": "initial-phone-preference", "label": "初始电话偏好及来源",
      "tool": "query_memory", "args": {"query": "沟通偏好", "person_id": "lin_a", "top_k": 1},
      "expect": {"ids": ["preference"], "only": true, "contains": ["电话"], "absent": ["短信", "邮件"]}
    },
    {
      "id": "edited-email-preference", "label": "编辑后召回邮件且不残留电话",
      "actions": [{"op": "edit", "memory": "preference", "text": "林舟的沟通偏好已更正为邮件，工作日通常下午方便联系。"}],
      "tool": "query_memory", "args": {"query": "沟通偏好", "person_id": "lin_a"},
      "expect": {"ids": ["preference"], "only": true, "contains": ["邮件"], "absent": ["电话", "短信"]}
    },
    {
      "id": "withdrawn-preference-excluded", "label": "撤销后不进入当前召回",
      "actions": [{"op": "edit", "memory": "preference", "text": "林舟的沟通偏好是邮件。"}, {"op": "withdraw", "memory": "preference"}],
      "tool": "query_memory", "args": {"query": "沟通偏好", "person_id": "lin_a"},
      "expect": {"ids": [], "only": true}
    },
    {
      "id": "restored-preference-retains-edit", "label": "恢复后保留纠错结果",
      "actions": [{"op": "edit", "memory": "preference", "text": "林舟的沟通偏好是邮件。"}, {"op": "withdraw", "memory": "preference"}, {"op": "restore", "memory": "preference"}],
      "tool": "query_memory", "args": {"query": "沟通偏好", "person_id": "lin_a"},
      "expect": {"ids": ["preference"], "only": true, "contains": ["邮件"], "absent": ["电话"]}
    },
    {
      "id": "namesake-explicit-id-isolation", "label": "同名人物按ID隔离",
      "tool": "query_memory", "args": {"query": "沟通偏好", "person_id": "lin_b", "top_k": 1},
      "expect": {"ids": ["namesake"], "only": true, "contains": ["短信"], "absent": ["电话", "邮件"]}
    },
    {
      "id": "namesake-argument-needs-confirmation", "label": "同名姓名参数要求确认",
      "tool": "query_memory", "args": {"query": "沟通偏好", "person": "林舟"},
      "expect": {"needs_confirmation": ["lin_a", "lin_b"]}
    },
    {
      "id": "namesake-in-query-needs-confirmation", "label": "查询中的同名人物要求确认",
      "tool": "query_memory", "args": {"query": "林舟的沟通偏好是什么"},
      "expect": {"needs_confirmation": ["lin_a", "lin_b"]}
    },
    {
      "id": "archived-person-excluded", "label": "全局召回排除归档人物",
      "actions": [{"op": "archive_person", "person": "lin_a"}],
      "tool": "query_memory", "args": {"query": "工作日"},
      "expect": {"ids": [], "only": true}
    },
    {
      "id": "restored-person-visible", "label": "人物恢复后重新可见",
      "actions": [{"op": "archive_person", "person": "lin_a"}, {"op": "restore_person", "person": "lin_a"}],
      "tool": "query_memory", "args": {"query": "沟通偏好", "person_id": "lin_a"},
      "expect": {"ids": ["preference"], "only": true, "contains": ["电话"]}
    },
    {
      "id": "transferred-memory-leaves-old-owner", "label": "转移后原人物不再召回",
      "actions": [{"op": "edit", "memory": "preference", "person_id": "zhou"}],
      "tool": "query_memory", "args": {"query": "沟通偏好", "person_id": "lin_a"},
      "expect": {"ids": [], "only": true}
    },
    {
      "id": "transferred-memory-new-owner-source", "label": "转移后来源标注新人物",
      "actions": [{"op": "edit", "memory": "preference", "person_id": "zhou"}],
      "tool": "query_memory", "args": {"query": "工作日", "person_id": "zhou"},
      "expect": {"ids": ["preference"], "only": true, "contains": ["电话"]}
    },
    {
      "id": "personal-scope-isolation", "label": "个人范围不混入人物记忆",
      "tool": "query_memory", "args": {"query": "沟通偏好", "scope": "personal"},
      "expect": {"ids": ["personal"], "only": true, "contains": ["邮件", "清单"], "absent": ["短信", "电话"]}
    },
    {
      "id": "transfer-to-personal-scope", "label": "转为个人记忆后可按个人范围召回",
      "actions": [{"op": "edit", "memory": "preference", "person_id": null}],
      "tool": "query_memory", "args": {"query": "工作日", "scope": "personal"},
      "expect": {"ids": ["preference"], "only": true, "contains": ["电话"]}
    },
    {
      "id": "city-current-versus-history", "label": "当前上海与历史杭州有明确时间状态",
      "tool": "get_person", "args": {"person_id": "lin_a"},
      "expect": {"card_contains": ["city=上海"], "card_absent": ["city=杭州"], "fields": [
        {"field": "city", "text": "上海", "temporal_status": "current_field"},
        {"field": "city", "text": "杭州", "temporal_status": "historical_field"}
      ], "memory_sources": ["preference"]}
    },
    {
      "id": "interaction-source-snapshot", "label": "联系记录召回包含实际原文与人物",
      "tool": "query_memory", "args": {"query": "实际拜访", "person_id": "zhou"},
      "expect": {"ids": ["visit"], "only": true, "contains": ["秋季产品计划"]}
    },
    {
      "id": "multiple-relevant-records", "label": "同一人物的活动记忆与联系原文共同召回",
      "tool": "query_memory", "args": {"query": "周敏 产品"},
      "expect": {"ids": ["meeting", "visit"], "only": true, "contains": ["产品交流会", "秋季产品计划"]}
    },
    {
      "id": "unknown-person-no-global-fallback", "label": "未知人物不退回全库召回",
      "tool": "query_memory", "args": {"query": "沟通偏好", "person": "不存在的人物"},
      "expect": {"error": true}
    },
    {
      "id": "unrelated-query-no-hit", "label": "无相关内容时返回空结果",
      "tool": "query_memory", "args": {"query": "deepoceanvolcano"},
      "expect": {"ids": [], "only": true}
    }
  ]
}
